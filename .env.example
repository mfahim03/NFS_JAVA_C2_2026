# Support Desk application configuration
# Copy this file to .env and replace the placeholder values for local use.
#
# Commit this example file, but never commit .env. A real .env can contain
# credentials and machine-specific settings that must not be exposed in Git.

# ===== REQUIRED =====
# JWT Secret for token signing (MUST be at least 32 characters, never use the demo key in production)
# Generate a secure key: $(openssl rand -base64 32)
JWT_SECRET=replace-with-a-secure-jwt-secret-at-least-32-characters

# ===== OPTIONAL (defaults provided) =====
# JWT token expiration in minutes
JWT_EXPIRATION_MINUTES=60

# MongoDB port on host machine (container always uses 27017 internally)
MONGO_HOST_PORT=27018

# Backend API port on host machine
BACKEND_PORT=8080

# Frontend UI port on host machine
FRONTEND_PORT=5173
